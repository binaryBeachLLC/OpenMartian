# Copy to .env and fill in. Loaded automatically if python-dotenv is installed.

# --- Cloud backend (Claude / Haiku) ---
ANTHROPIC_API_KEY=

# --- Webcam RTSP source (your Windows cam over NetBird) ---
# Matches ~/bin/webcam-view. Override per-run with `capture --url`.
OM_RTSP_URL=rtsp://100.68.17.41:8554/webcam

# --- Local VLM ---
OLLAMA_HOST=http://localhost:11434

# --- Optional notify sink ---
# DISCORD_WEBHOOK_URL=

# --- Deferred (DeepSeek API is text-only; not wired in v0) ---
# DEEPSEEK_API_KEY=
